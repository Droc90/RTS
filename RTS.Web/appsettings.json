{
  "Application": {
    "Name": "RTS",
    "DisplayName": "Ranked Trading System",
    "CookieName": ".RTS.Auth",
    "DataProtectionName": "RTS"
  },

  "AccountRequestLimits": {
    "PermitLimit": 3,
    "WindowMinutes": 15
  },

  "Security": {
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  },

  "AI": {
    "OpenAI": {
      "CandidateDiscovery": {
        "ApiKey": "",
        "Model": "",
        "Endpoint": "https://api.openai.com/v1/responses",
        "TimeoutSeconds": 120
      }
    }
  },

  "MarketData": {
    "Alpaca": {
      "ApiKeyId": "",
      "ApiSecretKey": "",
      "BaseUrl": "https://data.alpaca.markets",
      "Feed": "iex",
      "TimeoutSeconds": 60
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

