{
  "Application": {
    "Name": "RTS",
    "DisplayName": "Ranked Trading System",
    "CookieName": ".RTS.Auth",
    "DataProtectionName": "RTS"
  },

  "AccountRequestLimits": {
    "PermitLimit": 3,
    "WindowMinutes": 15
  },

  "Security": {
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

