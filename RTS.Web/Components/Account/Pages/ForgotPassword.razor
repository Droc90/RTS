@page "/account/forgot-password"

@using Microsoft.AspNetCore.Authorization
@using RTS.Application.Identity
@using RTS.Web.Components.Account.Models

@attribute [AllowAnonymous]

@inject IPasswordRecoveryService PasswordRecoveryService
@inject NavigationManager Navigation
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot password</PageTitle>

<h1>Forgot password</h1>

@if (_submitted)
{
    <div class="alert alert-success" role="alert">
        If an eligible account exists for that email address,
        a password-reset message has been sent.
    </div>

    <a href="/account/login">
        Back to login
    </a>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    <p>
        Enter your email address and we’ll send a
        password-reset link if the account is eligible.
    </p>

    <EditForm Model="_model"
              OnValidSubmit="SendAsync"
              FormName="forgot-password">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="email" class="form-label">
                Email address
            </label>

            <InputText id="email"
                       class="form-control"
                       @bind-Value="_model.Email"
                       autocomplete="email" />

            <ValidationMessage For="() => _model.Email" />
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@_isSubmitting">
            @(_isSubmitting
                ? "Sending..."
                : "Send password-reset link")
        </button>
    </EditForm>

    <div class="mt-3">
        <a href="/account/login">
            Back to login
        </a>
    </div>
}

@code {
    private readonly ForgotPasswordModel _model = new();

    private bool _isSubmitting;
    private bool _submitted;
    private string? _errorMessage;

    private async Task SendAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var resetPageUri =
                Navigation.ToAbsoluteUri(
                    "account/reset-password");

            await PasswordRecoveryService.SendResetLinkAsync(
                _model.Email,
                resetPageUri);

            _submitted = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Password-reset email delivery failed.");

            _errorMessage =
                "The request could not be processed right now. " +
                "Please try again later.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}