@page "/account/reset-password"

@using Microsoft.AspNetCore.Authorization
@using RTS.Application.Identity
@using RTS.Web.Components.Account.Models

@attribute [AllowAnonymous]

@inject IPasswordRecoveryService PasswordRecoveryService

<PageTitle>Reset password</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <h1 class="h2">Reset password</h1>

                @if (_succeeded)
                {
                    <div class="alert alert-success"
                         role="status"
                         aria-live="polite">
                        Your password has been reset
                        successfully.
                    </div>

                    <a class="btn btn-primary w-100"
                       href="/account/login">
                        Continue to login
                    </a>
                }
                else if (!HasLinkParameters)
                {
                    <div class="alert alert-danger"
                         role="alert"
                         aria-live="assertive">
                        The password-reset link is invalid or
                        incomplete.
                    </div>

                    <a class="btn btn-primary w-100"
                       href="/account/forgot-password">
                        Request a new password-reset link
                    </a>
                }
                else
                {
                    @if (_errors.Count > 0)
                    {
                        <div class="alert alert-danger"
                             role="alert"
                             aria-live="assertive">
                            <p class="fw-semibold mb-2">
                                The password could not be reset:
                            </p>

                            <ul class="mb-0">
                                @foreach (var error in _errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <EditForm Model="_model"
                              OnValidSubmit="ResetAsync"
                              FormName="reset-password">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="reset-new-password"
                                   class="form-label required-field">
                                New password
                            </label>

                            <InputText id="reset-new-password"
                                       class="form-control"
                                       type="password"
                                       @bind-Value="_model.NewPassword"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       aria-describedby="reset-password-help" />

                            <div id="reset-password-help"
                                 class="form-text">
                                Use at least 10 characters with
                                uppercase, lowercase, number, and
                                special-character combinations.
                            </div>

                            <ValidationMessage For="@(() => _model.NewPassword)" />
                        </div>

                        <div class="mb-4">
                            <label for="reset-confirm-password"
                                   class="form-label required-field">
                                Confirm new password
                            </label>

                            <InputText id="reset-confirm-password"
                                       class="form-control"
                                       type="password"
                                       @bind-Value="_model.ConfirmPassword"
                                       autocomplete="new-password"
                                       aria-required="true" />

                            <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100"
                                disabled="@_isSubmitting">
                            @(_isSubmitting
                                ? "Resetting password..."
                                : "Reset password")
                        </button>
                    </EditForm>

                    <div class="border-top mt-4 pt-4 text-center">
                        <a href="/account/forgot-password">
                            Request a different reset link
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public Guid? UserExternalId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordModel _model = new();

    private IReadOnlyCollection<string> _errors =
        Array.Empty<string>();

    private bool _isSubmitting;
    private bool _succeeded;

    private bool HasLinkParameters =>
        UserExternalId is Guid externalUserId &&
        externalUserId != Guid.Empty &&
        !string.IsNullOrWhiteSpace(Token);

    private async Task ResetAsync()
    {
        if (UserExternalId is not Guid externalUserId ||
            string.IsNullOrWhiteSpace(Token))
        {
            _errors =
            [
                "The password-reset link is invalid or incomplete."
            ];

            return;
        }

        _isSubmitting = true;
        _errors = Array.Empty<string>();

        try
        {
            var result =
                await PasswordRecoveryService
                    .ResetPasswordAsync(
                        externalUserId,
                        Token,
                        _model.NewPassword);

            if (!result.Succeeded)
            {
                _errors = result.Errors;
                return;
            }

            _succeeded = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}