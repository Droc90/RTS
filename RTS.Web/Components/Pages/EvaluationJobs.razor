@page "/evaluation-jobs"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using RTS.Application.EvaluationJobs
@using RTS.Web.Identity
@inject IEvaluationJobService JobService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Evaluation Jobs</PageTitle>

<section class="py-4" aria-labelledby="jobs-heading">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 id="jobs-heading" class="h2 mb-1">Evaluation Jobs</h1><p class="text-body-secondary mb-0">Durable progress continues independently of this browser session.</p></div>
        <button class="btn btn-outline-secondary" disabled="@isBusy" @onclick="LoadAsync">Refresh</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(isError ? "alert-danger" : "alert-success")" role="status">@message</div> }
    @if (isBusy) { <p>Loading jobs…</p> }
    else if (jobs.Count == 0) { <div class="card"><div class="card-body">No evaluations have been queued.</div></div> }
    else
    {
        <div class="table-responsive"><table class="table align-middle">
            <thead><tr><th>Symbol</th><th>Status</th><th>Progress</th><th>Attempts</th><th>Created</th><th>Actions</th></tr></thead>
            <tbody>@foreach (var job in jobs) { <tr>
                <th scope="row">@job.Symbol</th><td>@job.Status</td>
                <td style="min-width:12rem"><div class="progress" role="progressbar" aria-valuenow="@job.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@($"{job.ProgressPercent}%")">@job.ProgressPercent%</div></div><small>@(job.ErrorMessage ?? job.ProgressMessage)</small></td>
                <td>@job.AttemptCount</td><td>@job.CreatedUtc.ToLocalTime().ToString("g")</td>
                <td><div class="d-flex gap-1"><button class="btn btn-sm btn-outline-danger" disabled="@(job.Status is not (EvaluationJobStatus.Queued or EvaluationJobStatus.Running))" @onclick="() => CancelAsync(job)">Cancel</button><button class="btn btn-sm btn-outline-primary" disabled="@(job.Status is not (EvaluationJobStatus.Failed or EvaluationJobStatus.Cancelled))" @onclick="() => RetryAsync(job)">Retry</button></div></td>
            </tr> }</tbody>
        </table></div>
    }
</section>

@code {
    private IReadOnlyCollection<EvaluationJobDetails> jobs = [];
    private Guid userExternalId;
    private bool isBusy = true;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (!principal.TryGetExternalUserId(out userExternalId)) { isBusy = false; isError = true; message = "Your user identifier is unavailable."; return; }
        await LoadAsync();
    }

    private async Task LoadAsync() { isBusy = true; jobs = await JobService.GetJobsAsync(userExternalId); isBusy = false; }
    private Task CancelAsync(EvaluationJobDetails job) => ChangeAsync(job, false);
    private Task RetryAsync(EvaluationJobDetails job) => ChangeAsync(job, true);

    private async Task ChangeAsync(EvaluationJobDetails job, bool retry)
    {
        isBusy = true;
        var changed = retry
            ? await JobService.RetryAsync(userExternalId, job.ExternalId, job.RowVersion)
            : await JobService.CancelAsync(userExternalId, job.ExternalId, job.RowVersion);
        isError = !changed;
        var action = retry ? "queued for retry" : "cancelled";
        message = changed ? $"{job.Symbol} was {action}." : "The job changed elsewhere. Refresh and try again.";
        jobs = await JobService.GetJobsAsync(userExternalId);
        isBusy = false;
    }
}
