<div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="@Id" checked="@Value" @onchange="Changed" /><label class="form-check-label" for="@Id">@Label</label></div></div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    private Task Changed(ChangeEventArgs args) => ValueChanged.InvokeAsync((bool?)args.Value == true);
}
