{
  "Security": {
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  },

  "Email": {
    "Smtp": {
      "Port": 587,
      "SocketOptions": "StartTls",
      "TimeoutSeconds": 30
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}